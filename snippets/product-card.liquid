<div class="w-full py-6 px-3">
  <div class="bg-white shadow-lg rounded-lg overflow-hidden">

    <a href="{{ product_product.url }}">
      {% if product_product.featured_image %}
        <div class="h-80 overflow-hidden">
          <img src="{{ product_product.featured_image | image_url }}" width="{{ product_product.featured_image.width }}" height="{{ product_product.featured_image.height }}" alt="{{ product_product.featured_image.alt }}" class="w-full h-full object-cover" />
        </div>
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'w-full h-full oject-cover bg-gray-100' }}
      {% endif %}
    </a>

    <div class="flex flex-col p-4">
      <span class="text-sm text-gray-400">{{ product_product.vendor }}</span>
      
      <a href="{{ product_product.url }}" class="text-gray-700 uppercase font-medium">{{ product_product.title }}</a>
      <p class="text-gray-500">{{ product_product.price | money }}</p>
    </div>
  </div>
</div>
